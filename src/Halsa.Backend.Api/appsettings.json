{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=halsa.backend;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/halsa.backend",
    "Audience": "halsa.backend-api",
    "ClientId": "halsa.backend-api",
    "RequireHttpsMetadata": false
  },
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
