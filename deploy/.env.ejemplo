# ─────────────────────────────────────────────────────────────────────────────
# .env.ejemplo — PRODUCCIÓN (deploy/docker-compose.prod.yml, SPEC 13).
#
#   cp .env.ejemplo .env && chmod 600 .env     # en /opt/halsa/deploy, runbook 01
#
# Aquí NO van secretos: solo nombres, rutas y valores no sensibles. Los secretos son
# archivos en HALSA_SECRETOS (root:root 0600), uno por secreto, con estos nombres:
#
#   halsa_kek               32 bytes aleatorios en base64 (la KEK, SPEC 03; runbook 02)
#   halsa_sello             la llave de sello (SPEC 11; pendiente, runbook 05)
#   pg_postgres_password    superusuario de PostgreSQL
#   pg_owner_password       halsa_owner (migraciones)
#   pg_app_password         halsa_app
#   pg_clinico_password     halsa_clinico
#   pg_ingesta_password     halsa_ingesta
#   pg_worker_password      halsa_worker
#   backups_s3_key          access key del bucket de backups (pgBackRest)
#   backups_s3_secret       secret key del bucket de backups
#   backups_cipher_pass     passphrase del cifrado AES-256 del repositorio de pgBackRest
#   worm_s3_key             access key del bucket WORM (SPEC 11; pendiente)
#   worm_s3_secret          secret key del bucket WORM (SPEC 11; pendiente)
#   kc_bff_secret           client secret de halsa-bff-paciente en el Keycloak compartido
#   redis_password          requirepass de Redis
#
# Generar uno:  openssl rand -base64 32 | tr -d '\n' > /etc/halsa/secretos/<nombre>
# ─────────────────────────────────────────────────────────────────────────────

# ── Hosts de Halsa (proxy hosts de NPM) ──────────────────────────────────────
HALSA_HOST_API=halsa-api.edcastdev.com
HALSA_HOST_INTEGRACIONES=halsa-integraciones.edcastdev.com
HALSA_HOST_PACIENTES=halsa-pacientes.edcastdev.com

# ── Versión e imágenes ────────────────────────────────────────────────────────
# Lo fija desplegar.sh en cada despliegue; no lo edites a mano.
HALSA_TAG=v1.0.0
# Organización (o usuario) de GitHub dueña de las imágenes en GHCR: ghcr.io/<org>/halsa-backend.
HALSA_GHCR_ORG=halsa
# Tag de la imagen de PostgreSQL (deploy/postgres/Dockerfile), publicada por release.yml.
HALSA_POSTGRES_TAG=17

# ── Keycloak compartido ──────────────────────────────────────────────────────
# URL pública (el emisor de los tokens es <URL>/realms/halsa) y su host, que api y bff resuelven a NPM.
HALSA_KEYCLOAK_URL=https://auth.edcastdev.com
HALSA_KEYCLOAK_HOST=auth.edcastdev.com
# Contenedor, para keycloak/importar-realms.sh (kcadm por docker exec).
HALSA_KEYCLOAK_CONTENEDOR=keykloack-keycloak-1
# Cómo llega NPM a Keycloak: el MISMO upstream que usa el proxy host de auth.edcastdev.com.
HALSA_UPSTREAM_KEYCLOAK=http://keykloack-keycloak-1:8080

# ── Nginx Proxy Manager (no se modifica su compose; runbook 01) ───────────────
# Nombre del contenedor de NPM y la carpeta del host montada como su /data.
HALSA_NPM_CONTENEDOR=npm-app-1
HALSA_NPM_DATA=/opt/npm/data
# IP fija de NPM en la red halsa_borde: el único proxy de confianza de la API y el BFF.
HALSA_NPM_IP=172.30.0.10

# ── Rutas en el VPS ───────────────────────────────────────────────────────────
# Secretos de Docker (root:root 0600, EXCLUIDOS de los backups y snapshots: runbook 02).
HALSA_SECRETOS=/etc/halsa/secretos
# Cadena y CRL públicas de la CA de integraciones (deploy/pki/generar-crl.sh las publica aquí;
# sincronizar-npm.sh las copia a NPM).
HALSA_PKI_PUBLICADA=/etc/halsa/pki/publicar

# ── Frontend ──────────────────────────────────────────────────────────────────
# Origen del SPA del backoffice (redirect URI y web origin de halsa-backoffice).
HALSA_BACKOFFICE_URL=https://halsa-backoffice.edcastdev.com

# ── Clínico ───────────────────────────────────────────────────────────────────
# Identificador de la KEK vigente (rotación: runbook 05).
HALSA_KEK_ID=local:v1

# ── Backups (pgBackRest → bucket S3 externo, DISTINTO del WORM) ───────────────
HALSA_BACKUPS_BUCKET=halsa-backups
HALSA_BACKUPS_REGION=us-east-1
HALSA_BACKUPS_ENDPOINT=s3.us-east-1.amazonaws.com

# ── Observabilidad ────────────────────────────────────────────────────────────
# Dead man's switch del Worker (p. ej. https://hc-ping.com/<uuid>); vacío lo desactiva.
HALSA_HEARTBEAT_URL=
# Seq: hash de la contraseña del admin del primer arranque:
#   echo '<contraseña>' | docker run --rm -i datalust/seq config hash
HALSA_SEQ_ADMIN_HASH=
HALSA_SEQ_TAG=2025.2
# API key de ingesta, si Seq la exige (Settings → API Keys).
HALSA_SEQ_API_KEY=
