<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC 14: coverage of Domain and Application only, in Cobertura format. ci.yml ("Exigir cobertura") requires
     each package's line-rate to reach COBERTURA_MINIMA. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Halsa.Backend.Domain]*,[Halsa.Backend.Application]*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
