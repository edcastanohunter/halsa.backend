        { "name": "integracion:furep:write",   "description": "Enviar FUREP a través de integración",      "composite": false, "clientRole": true },
        { "name": "integracion:clinico:write", "description": "Enviar datos clínicos a través de integración", "composite": false, "clientRole": true },
