        { "name": "casos:write",               "description": "Crear y modificar casos ATEL",              "composite": false, "clientRole": true },
        { "name": "casos:asignar",             "description": "Asignar personal a un caso",                "composite": false, "clientRole": true },
        { "name": "incapacidades:read",        "description": "Leer incapacidades",                        "composite": false, "clientRole": true },
        { "name": "incapacidades:write",       "description": "Registrar y modificar incapacidades",       "composite": false, "clientRole": true },
        { "name": "plazos:read",               "description": "Consultar plazos legales",                  "composite": false, "clientRole": true },
