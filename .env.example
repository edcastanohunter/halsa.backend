# ─────────────────────────────────────────────────────────────────────────────
# .env.example — DESARROLLO (docker-compose.yml de la raíz). Copia a .env si necesitas cambiar
# algo; sin .env, podman compose usa los valores por defecto que aparecen aquí.
# Producción tiene su propio archivo: deploy/.env.ejemplo.
#
# No pongas secretos reales aquí: todo lo de desarrollo es de juguete (roles *_dev, admin/admin).
# ─────────────────────────────────────────────────────────────────────────────

# ── Nginx de desarrollo (SPEC 13, docker/nginx-dev/README.md) ────────────────
# La API y el BFF corren en el host con `dotnet run`; Nginx llega a ellos por host.docker.internal.
HALSA_DEV_UPSTREAM_API=http://host.docker.internal:5600
HALSA_DEV_UPSTREAM_BFF=https://host.docker.internal:5610
# Puerto del host para https://*.localhost. Si el 443 está ocupado, p. ej. 8443 (y usa :8443 en las URLs).
HALSA_DEV_PUERTO_HTTPS=443

# ── Lo que leen la API y el BFF en el host (no podman compose) ───────────────
# Van en appsettings.Development.json, user-secrets o variables de entorno; se listan aquí para tenerlas a mano.
#
# API (src/Halsa.Backend.Api):
#   Clinico__KekBase64=<32 bytes en base64>          dotnet user-secrets (SPEC 03); nunca en Production
#   Halsa__Rol=Ambos|Api|Worker                       Ambos por defecto en Development (SPEC 09)
#   Integraciones__ExigirCertificado=true             perfil "mtls": exige el certificado ligado (SPEC 13)
#   Red__ProxyConfiable=127.0.0.0/8,::1/128,172.16.0.0/12,192.168.65.0/24   ya en appsettings.Development.json
#
# BFF (src/Halsa.Bff.Paciente):
#   Bff__ClientSecret=halsa-bff-paciente-dev-secret   ya en appsettings.Development.json
#   Red__ProxyConfiable=...                           ya en appsettings.Development.json
